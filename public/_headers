# Response headers on Cloudflare Workers static assets (the host reads this file and never serves it).
# The same /* block applies to `vite preview`, so the browser tests run under this policy too.
# Caching: the host's default (revalidate on every request) is what the offline worker needs; do not
# mark assets immutable, the worker checks each file's hash on install.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/manifest.webmanifest
  Content-Type: application/manifest+json
