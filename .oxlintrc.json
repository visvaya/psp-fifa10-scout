{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-param-reassign": ["error", { "props": true }],
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": "error",
    "no-console": "error",
    "no-alert": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/throw-new-error": "error",

    "max-depth": ["error", 3],
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "error",
      { "max": 60, "skipBlankLines": true, "skipComments": true }
    ],
    "max-nested-callbacks": ["error", 3],
    "complexity": ["error", 15],
    "max-params": ["error", 4],

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-readonly": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",

    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "import/no-namespace": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],

    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-array-index-key": "error",
    "react/jsx-no-literals": "error",

    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-identical-title": "error"
  },
  "overrides": [
    {
      "files": ["src/logic/**", "src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ui/**", "react", "react-dom", "react-dom/*"],
                "message": "Logic and data layers stay free of UI and framework code."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          { "name": "window", "message": "Logic and data layers must not depend on the browser." },
          {
            "name": "document",
            "message": "Logic and data layers must not depend on the browser."
          },
          {
            "name": "navigator",
            "message": "Logic and data layers must not depend on the browser."
          },
          { "name": "localStorage", "message": "Persistence goes through the storage adapter." }
        ],
        "no-restricted-properties": [
          "error",
          { "object": "Math", "property": "random", "message": "Use the seeded RNG." }
        ]
      }
    },
    {
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ui/**", "**/logic/**", "react", "react-dom", "react-dom/*"],
                "message": "The data layer does not import logic or UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["*.config.ts", "*.config.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "node_modules", ".scratch"]
}
